{
  "name": "@dcos/contracts",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema/contracts.schema.json": "./schema/contracts.schema.json",
    "./schema/example-payloads.json": "./schema/example-payloads.json"
  },
  "files": ["src", "schema"],
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "build": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
