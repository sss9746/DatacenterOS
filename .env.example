# Copy to .env.local (gitignored) and fill in. Never commit token values.
# Names are frozen by plans/CONTRACTS.md §10.

# --- SpacetimeDB ---
STDB_HOST=https://maincloud.spacetimedb.com      # VERIFY the base URL at the booth or in the docs (local: http://localhost:3000)
STDB_DB=dcos                                     # dcos (prod/demo) | dcos-dev | dcos-eval (local eval)
STDB_AGENT_TOKEN=                                # agents' NON-owner identity (role agent)
STDB_BRIDGE_TOKEN=                               # fan bridge identity (role bridge)
STDB_ADMIN_TOKEN=                                # admin identity (eval / ops only)
STDB_MODE=live                                   # live | fixture

# --- LLM ---
NIM_BASE_URL=http://<brev-host>:8000/v1
NIM_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning
NVIDIA_API_KEY=                                  # fallback: https://integrate.api.nvidia.com/v1
NVIDIA_HOSTED_MODEL=
LLM_LOCAL_BASE_URL=                              # last-resort local OpenAI-compatible server
LLM_LOCAL_MODEL=
LLM_MAX_TOKENS=512
LLM_MAX_STEPS=8

# --- Fan bridge ---
FAN_SERIAL_PORT=COM5
FAN_RACK_ID=rack_3

# --- Web (Vite). Every VITE_* value is PUBLIC in the JS bundle. ---
VITE_STDB_URI=wss://maincloud.spacetimedb.com
VITE_STDB_DB=dcos
VITE_AGENT_URL=http://localhost:8787
VITE_STDB_PRESENTER_TOKEN=                       # demo laptop local build ONLY; never set on Vercel
VITE_DATA_MODE=live                              # fixture | live | http
