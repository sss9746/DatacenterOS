# Copy to .env.local (gitignored) and fill in. Never commit token values.
# Names are frozen by plans/CONTRACTS.md §0.10.

# --- SpacetimeDB ---
STDB_URI=wss://maincloud.spacetimedb.com         # VERIFY at the booth (local: ws://localhost:3000)
STDB_DB=dcos-dev                                 # dcos-dev (dev) | dcos (demo) | dcos-eval (local)
STDB_ADMIN_TOKEN=                                # role admin (judge controls, eval publishing)
STDB_AGENT_TOKEN=                                # role agent (P3 orchestrator)
STDB_GATEWAY_TOKEN=                              # role gateway (fan gateway, nvidia-smi collector)

# --- NVIDIA NIM (OpenAI-compatible) ---
NIM_BASE_URL=http://<brev-host>:8000/v1          # self-hosted NIM on Brev
NIM_API_KEY=
NIM_MODEL=                                       # record the tool-calling model id found in P3-0
NIM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_FALLBACK_MODEL=
LLM_MAX_TOKENS=768
LLM_MAX_TOOL_STEPS=8
LLM_TIMEOUT_MS=20000

# --- Hardware ---
FAN_SERIAL_PORT=COM5

# --- Web (Vite). Every VITE_* value is PUBLIC in the JS bundle. ---
VITE_STDB_URI=wss://maincloud.spacetimedb.com
VITE_STDB_DB=dcos
VITE_DATA_MODE=mock                              # mock | live
VITE_ADMIN_TOKEN=                                # presenter laptop local build ONLY; never set on Vercel
