{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacenteros.local/schemas/contracts-1.0.0.json",
  "title": "DataCenterOS v1.0.0 canonical cross-service contracts",
  "description": "Canonical JSON wire contracts for simulation, agents, evaluation, hardware gateway. SpacetimeDB tables separately map these fields to native indexed columns.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "RunClock": {
      "type": "object",
      "properties": {
        "sim_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tick_index": {
          "type": "integer",
          "minimum": 0
        },
        "step_ms": {
          "type": "integer",
          "minimum": 1
        },
        "wall_tick_ms": {
          "type": "integer",
          "minimum": 1
        },
        "paused": {
          "type": "boolean"
        },
        "decision_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sim_time_ms",
        "tick_index",
        "step_ms",
        "wall_tick_ms",
        "paused",
        "decision_epoch"
      ],
      "additionalProperties": false
    },
    "ResourceSpec": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "rack",
            "node",
            "gpu",
            "cooling_pump",
            "cooling_loop",
            "network_link",
            "checkpoint_store",
            "fan_sensor",
            "power_domain"
          ]
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_domain_id": {
          "$ref": "#/$defs/Identifier"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "resource_id",
        "kind",
        "parent_id",
        "failure_domain_id",
        "profile",
        "config",
        "enabled"
      ],
      "additionalProperties": false
    },
    "DependencyEdge": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "edge_id": {
          "$ref": "#/$defs/Identifier"
        },
        "consumer_id": {
          "$ref": "#/$defs/Identifier"
        },
        "provider_id": {
          "$ref": "#/$defs/Identifier"
        },
        "relation": {
          "type": "string",
          "enum": [
            "hosted_on",
            "cooled_by",
            "powered_by",
            "connected_via",
            "checkpoint_uses",
            "monitored_by"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "edge_id",
        "consumer_id",
        "provider_id",
        "relation",
        "weight"
      ],
      "additionalProperties": false
    },
    "JobSpec": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "job_id": {
          "$ref": "#/$defs/Identifier"
        },
        "gpus_required": {
          "type": "integer",
          "minimum": 1
        },
        "placement_policy": {
          "type": "string",
          "enum": [
            "same_node",
            "gang_multi_node"
          ]
        },
        "compatible_node_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "gpu_profile": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "preemptible": {
          "type": "boolean"
        },
        "checkpoint_supported": {
          "type": "boolean"
        },
        "checkpoint_storage_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "restart_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_interval_ms": {
          "type": "integer",
          "minimum": 0
        },
        "total_work_units": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "work_rate_per_gpu_per_sim_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "job_id",
        "gpus_required",
        "placement_policy",
        "compatible_node_ids",
        "gpu_profile",
        "priority",
        "preemptible",
        "checkpoint_supported",
        "checkpoint_storage_id",
        "checkpoint_duration_ms",
        "restart_duration_ms",
        "checkpoint_interval_ms",
        "total_work_units",
        "work_rate_per_gpu_per_sim_s"
      ],
      "additionalProperties": false
    },
    "JobState": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "job_id": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "checkpointing",
            "paused",
            "failed",
            "restarting",
            "completed"
          ]
        },
        "allocated_gpu_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "progress_work_units": {
          "type": "number",
          "minimum": 0
        },
        "durable_work_units": {
          "type": "number",
          "minimum": 0
        },
        "latest_checkpoint_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "last_update_sim_time_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "job_id",
        "status",
        "allocated_gpu_ids",
        "progress_work_units",
        "durable_work_units",
        "latest_checkpoint_id",
        "version",
        "last_update_sim_time_ms"
      ],
      "additionalProperties": false
    },
    "Checkpoint": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "job_id": {
          "$ref": "#/$defs/Identifier"
        },
        "storage_resource_id": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "writing",
            "complete",
            "failed"
          ]
        },
        "progress_work_units": {
          "type": "number",
          "minimum": 0
        },
        "requested_sim_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "complete_sim_time_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "accessible": {
          "type": "boolean"
        },
        "command_key": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "checkpoint_id",
        "job_id",
        "storage_resource_id",
        "status",
        "progress_work_units",
        "requested_sim_time_ms",
        "complete_sim_time_ms",
        "accessible",
        "command_key"
      ],
      "additionalProperties": false
    },
    "TelemetryEvent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "simulator",
            "hardware",
            "replay",
            "dcgm"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_seq": {
          "type": "integer",
          "minimum": 0
        },
        "observed_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "sim_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "quality": {
          "type": "string",
          "enum": [
            "good",
            "estimated",
            "stale",
            "missing",
            "invalid"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "run_id",
        "resource_id",
        "source_kind",
        "source_id",
        "source_seq",
        "observed_unix_ms",
        "sim_time_ms",
        "metric",
        "value",
        "unit",
        "quality",
        "labels"
      ],
      "additionalProperties": false
    },
    "SignalEvent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "simulator",
            "hardware",
            "replay",
            "dcgm"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_seq": {
          "type": "integer",
          "minimum": 0
        },
        "sim_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "observed_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "type": "string",
          "enum": [
            "xid_error",
            "gpu_unreachable",
            "node_unreachable",
            "checkpoint_lost",
            "sensor_timeout",
            "equipment_alarm",
            "resource_recovered"
          ]
        },
        "xid_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "evidence": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "run_id",
        "resource_id",
        "source_kind",
        "source_id",
        "source_seq",
        "sim_time_ms",
        "observed_unix_ms",
        "event_type",
        "xid_code",
        "severity",
        "message",
        "evidence"
      ],
      "additionalProperties": false
    },
    "FaultInjection": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "fault_id": {
          "$ref": "#/$defs/Identifier"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "target_resource_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "cooling_pump_degradation",
            "cooling_pump_outage",
            "gpu_thermal_load",
            "gpu_xid_48",
            "gpu_xid_79",
            "gpu_xid_74",
            "network_link_down",
            "node_crash",
            "sensor_stale"
          ]
        },
        "start_sim_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "duration_sim_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "seed_offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "fault_id",
        "run_id",
        "target_resource_id",
        "kind",
        "start_sim_time_ms",
        "duration_sim_ms",
        "severity",
        "parameters",
        "seed_offset"
      ],
      "additionalProperties": false,
      "description": "Private scenario ground truth; never expose to the agent."
    },
    "Incident": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "incident_id": {
          "$ref": "#/$defs/Identifier"
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "investigating",
            "mitigating",
            "monitoring",
            "resolved",
            "escalated"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "opened_sim_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "updated_sim_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "incident_id",
        "state",
        "severity",
        "title",
        "hypothesis",
        "confidence",
        "opened_sim_time_ms",
        "updated_sim_time_ms",
        "version"
      ],
      "additionalProperties": false
    },
    "IncidentLink": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "incident_id": {
          "$ref": "#/$defs/Identifier"
        },
        "linked_id": {
          "$ref": "#/$defs/Identifier"
        },
        "link_kind": {
          "type": "string",
          "enum": [
            "symptom",
            "resource",
            "workflow"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "incident_id",
        "linked_id",
        "link_kind",
        "reason"
      ],
      "additionalProperties": false
    },
    "PlanCandidate": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "workflow_id": {
          "$ref": "#/$defs/Identifier"
        },
        "incident_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "based_on_decision_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "command_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expected_completion_delay_sim_s": {
          "type": "number",
          "minimum": 0
        },
        "expected_lost_work_units": {
          "type": "number",
          "minimum": 0
        },
        "expected_gpu_busy_waste_s": {
          "type": "number",
          "minimum": 0
        },
        "failure_risk_estimate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "explanation": {
          "type": "string",
          "maxLength": 3000
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "run_id",
        "workflow_id",
        "incident_ids",
        "based_on_decision_epoch",
        "assumptions",
        "command_keys",
        "expected_completion_delay_sim_s",
        "expected_lost_work_units",
        "expected_gpu_busy_waste_s",
        "failure_risk_estimate",
        "explanation"
      ],
      "additionalProperties": false
    },
    "ActionCommand": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "action_id": {
          "$ref": "#/$defs/Identifier"
        },
        "command_key": {
          "$ref": "#/$defs/Identifier"
        },
        "workflow_id": {
          "$ref": "#/$defs/Identifier"
        },
        "plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "incident_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "operation": {
          "type": "string",
          "enum": [
            "keep_running",
            "power_cap",
            "checkpoint",
            "pause_job",
            "cordon_gpu",
            "migrate_restart",
            "uncordon_gpu",
            "escalate"
          ]
        },
        "target_resource_id": {
          "$ref": "#/$defs/Identifier"
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        },
        "depends_on_command_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "uniqueItems": true
        },
        "expected_decision_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "expected_resource_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "requested_sim_time_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "action_id",
        "command_key",
        "workflow_id",
        "plan_id",
        "incident_ids",
        "operation",
        "target_resource_id",
        "job_id",
        "arguments",
        "depends_on_command_keys",
        "expected_decision_epoch",
        "expected_resource_versions",
        "requested_sim_time_ms"
      ],
      "additionalProperties": false
    },
    "ActionStatus": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "action_id": {
          "$ref": "#/$defs/Identifier"
        },
        "command_key": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "claimed",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "needs_reconciliation"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "updated_sim_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "object",
          "additionalProperties": true
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "action_id",
        "command_key",
        "status",
        "attempt",
        "updated_sim_time_ms",
        "result",
        "reason_code",
        "version"
      ],
      "additionalProperties": false
    },
    "SafetyDecision": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "plan_id": {
          "$ref": "#/$defs/Identifier"
        },
