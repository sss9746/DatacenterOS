{
  "name": "nvidia-smi-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Streams a real Brev GPU's nvidia-smi readings into DataCenterOS as gpu-real-0 (observation only).",
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dcos/contracts": "workspace:*",
    "@dcos/db-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
