      "html": "<section class=\"ds-panel\" aria-labelledby=\"ds-panel-title\"><div class=\"ds-panel-heading\"><h2 id=\"ds-panel-title\">Policy benchmarks</h2></div><div class=\"ds-empty\"><strong>No matched evaluation runs yet</strong><p>No benchmark values are prefilled.</p></div></section>",
      "css": ".ds-panel{background:var(--surface,#171e27);border:1px solid var(--line,#303c49);border-radius:12px;min-width:0;overflow:clip;color:var(--foreground,#e8edf2);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;line-height:1.5}.ds-panel-heading{min-height:62px;padding:17px 20px;display:flex;gap:12px;justify-content:space-between;align-items:center}.ds-panel h2{margin:0;font-size:15px;font-weight:600;letter-spacing:-.015em}.ds-empty{padding:14px 20px 27px;color:var(--muted,#a6b4c3)}.ds-empty strong{color:#ced8e2;font-size:12px;font-weight:500}.ds-empty p{font-size:12px;margin:7px 0 0;line-height:1.7}"
