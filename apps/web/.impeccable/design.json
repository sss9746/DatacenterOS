      "html": "<div class=\"ds-progress\" role=\"progressbar\" aria-label=\"Illustrative training progress\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"70\"><i class=\"ds-work\"></i><i class=\"ds-durable\"></i><span class=\"ds-checkpoint\"></span></div>",
