      "css": ".ds-nav{display:flex;flex-direction:column;gap:6px;background:var(--shell,#111922);padding:12px;width:166px}.ds-nav a{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:6px;color:var(--muted,#a6b4c3);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:12px;font-weight:550;line-height:1.5;text-decoration:none}.ds-nav a:first-child{background:#243341;color:#e2edf6}.ds-nav a:hover{background:var(--surface-raised,#202a35);color:var(--foreground,#e8edf2)}.ds-nav a:focus-visible{outline:2px solid #b3d4ed;outline-offset:3px}"
