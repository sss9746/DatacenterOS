      "html": "<div class=\"ds-gpus\" aria-label=\"Illustrative thermal states\"><button class=\"ds-gpu ds-normal ds-selected\" aria-pressed=\"true\" aria-label=\"Selected illustrative GPU, 62 degrees Celsius\">62</button><button class=\"ds-gpu ds-warm\" aria-label=\"Illustrative warm GPU, 82 degrees Celsius\">82</button><button class=\"ds-gpu ds-hot\" aria-label=\"Illustrative hot GPU, 87 degrees Celsius\">87</button><button class=\"ds-gpu ds-fault\" aria-label=\"Illustrative faulted GPU, XID 79\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg>79</button><span class=\"ds-gpu ds-missing\" aria-label=\"No data\">\u2014</span></div>",
      "css": ".ds-gpus{display:grid;grid-template-columns:repeat(5,minmax(40px,1fr));gap:5px}.ds-gpu{position:relative;min-width:0;height:35px;border:1px solid #3f576c;border-radius:4px;display:flex;gap:3px;align-items:center;justify-content:center;font-family:\"SFMono-Regular\",Consolas,\"Liberation Mono\",monospace;font-variant-numeric:tabular-nums;font-size:12px;font-weight:500;cursor:pointer;transition:background-color 180ms ease-out}.ds-normal{background:#273d4b;color:#d8e7f2}.ds-warm{background:#55432e;border-color:#9f8054;color:#ffe0b2}.ds-hot{background:#684334;border-color:#b28064;color:#ffe1ca}.ds-fault{background:#5f3036;border-color:#b97479;color:#ffdbd6}.ds-missing{background:#20262e;color:var(--muted,#a6b4c3);border-style:dashed;cursor:default}.ds-gpu:hover{filter:brightness(1.23)}.ds-gpu:focus-visible{outline:2px solid #b3d4ed;outline-offset:3px}.ds-gpu.ds-selected{outline:2px solid #e0edf6;outline-offset:1px;z-index:1}@media(prefers-reduced-motion:reduce){.ds-gpu{transition:none}}"
