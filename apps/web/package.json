{
  "name": "@dcos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dcos/physics build && vite --host 127.0.0.1",
    "build": "pnpm --filter @dcos/physics build && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm --filter @dcos/physics build && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dcos/contracts": "workspace:*",
    "@dcos/db-client": "workspace:*",
    "@dcos/evaluation": "workspace:*",
    "@dcos/physics": "workspace:*",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^2.1.9"
  }
}
